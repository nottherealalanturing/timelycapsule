# Oracle tc-app edge. Cloudflare (proxied, SSL mode Full (strict)) -> Caddy -> api:4001.
#
# Client IP: Caddy only believes CF-Connecting-IP when the TCP peer is a
# Cloudflare address (list fetched 2026-11-06 from
# https://www.cloudflare.com/ips-v4 and /ips-v6; refresh it with
# deploy/oracle/tc-app/update-cloudflare-ips.sh when Cloudflare publishes changes).
# For any other peer the client IP is the peer itself, so a direct caller
# cannot spoof it. The API receives exactly ONE address in X-Forwarded-For and
# trusts exactly one hop (TRUST_PROXY_HOPS=1).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$API_DOMAIN} {
	# Cloudflare Origin CA certificate (15-year, trusted only by Cloudflare).
	# Files live OUTSIDE the repo in /opt/timelycapsule/certs (key mode 0600).
	tls /certs/origin.pem /certs/origin.key
	# PHASE 2 (after "Authenticated Origin Pulls" is switched ON for the zone in
	# Cloudflare and tested): replace the line above with
	#   tls /certs/origin.pem /certs/origin.key {
	#       client_auth {
	#           mode require_and_verify
	#           trust_pool file { pem_file /certs/authenticated_origin_pull_ca.pem }
	#       }
	#   }
	# Enabling it BEFORE Cloudflare presents the client cert would make every
	# request fail (Cloudflare 525/526).

	encode gzip

	reverse_proxy api:4001 {
		header_up X-Forwarded-For {client_ip}
	}

	log {
		output stdout
		format json
	}
}
