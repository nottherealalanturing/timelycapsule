#!/usr/bin/env python3
"""tc-secret: enter production secrets with hidden input, without echo, argv, history or logs.

  tc-secret env    FILE [--from SRC] [--like REF] KEY [KEY ...]   prompt (hidden) for each KEY and write KEY=VALUE into FILE
  tc-secret value  FILE --kind ping-url|age-recipient [--like REF] prompt for one value and store it alone in FILE
  tc-secret status FILE [--against OTHER]                         list KEYs in FILE: length, and same/different/absent vs OTHER (never values)

Design rules
  * Values are read from the controlling terminal (getpass); with no TTY the tool refuses (no piping secrets through ssh commands).
  * Nothing secret is ever printed: only key names, lengths and same/different/absent.
  * FILE is written atomically (temp file in the same directory, then rename) with mode 0600; the previous FILE is kept as FILE.bak-<UTC> (0600).
  * --from SRC seeds a NEW staged file from an existing env file (e.g. .env.production -> .env.production.next) so the staged file is complete.
    Services read the live file only: staging changes nothing that is running.
  * --like REF gives FILE the owner and group of REF (compose reads .env.production as 'ubuntu').
  * Values containing whitespace, quotes, '$', backticks or '#' are rejected (docker compose env_file would reinterpret them).
  * Known keys are checked against their expected format; a mismatch asks for an explicit 'yes'.
"""
import getpass, hashlib, os, re, shutil, stat, sys, time

PATTERNS = {
    "RESEND_API_KEY": r"re_[A-Za-z0-9_]{20,}",
    "RESEND_WEBHOOK_SECRET": r"whsec_[A-Za-z0-9+/=]{20,}",
    "RESEND_FROM_EMAIL": r"[^\s<>\"']+@[^\s<>\"']+",
    "R2_ACCOUNT_ID": r"[0-9a-f]{32}",
    "R2_ACCESS_KEY_ID": r"[0-9a-f]{32}",
    "R2_SECRET_ACCESS_KEY": r"[0-9a-f]{64}",
    "R2_ENDPOINT": r"https://[0-9a-f]{32}\.r2\.cloudflarestorage\.com",
    "R2_BUCKET_MEDIA": r"[a-z0-9][a-z0-9-]{2,62}",
    "HEALTHCHECKS_PING_URL": r"https://hc-ping\.com/[0-9a-f-]{36}(/[A-Za-z0-9_-]+)?",
    "LOCATIONIQ_API_KEY": r"[A-Za-z0-9._-]{16,}",
    "B2_KEY_ID": r"[0-9A-Za-z]{12,40}",
    "B2_APP_KEY": r"[A-Za-z0-9/+_-]{20,70}",
    "B2_BUCKET": r"[a-z0-9-]{6,63}",
}
KINDS = {"ping-url": (PATTERNS["HEALTHCHECKS_PING_URL"], True), "age-recipient": (r"age1[0-9a-z]{58}", False)}
FORBIDDEN = re.compile(r"[\s\"'`$#\\]")
TEST = os.environ.get("TC_SECRET_TEST_STDIN") == "1"   # tests only: read values from stdin instead of the terminal


def die(msg, code=1):
    print(f"tc-secret: {msg}", file=sys.stderr); sys.exit(code)


def ask(prompt, hidden=True):
    if TEST:
        return sys.stdin.readline().rstrip("\r\n")
    if not (os.path.exists("/dev/tty") and sys.stdin.isatty()):
        die("no terminal: run this interactively (ssh -t host sudo tc-secret ...); secrets are never accepted from pipes")
    return getpass.getpass(prompt) if hidden else input(prompt)


def confirm(text):
    if TEST:
        return os.environ.get("TC_SECRET_TEST_CONFIRM") == "yes"
    return input(text + " Type 'yes' to keep it anyway: ").strip() == "yes"


def parse(path):
    out, order = {}, []
    if os.path.exists(path):
        for line in open(path, encoding="utf-8").read().splitlines():
            m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line)
            if m:
                if m.group(1) not in out:
                    order.append(m.group(1))
                out[m.group(1)] = m.group(2)
    return out, order


def h(v):
    return hashlib.sha256(v.encode()).hexdigest()


def check_value(key, value, pattern):
    if not value:
        die(f"{key}: empty value, nothing written")
    if FORBIDDEN.search(value):
        die(f"{key}: value contains whitespace, quotes, '$', '#', backtick or backslash: refusing (compose env_file would alter it). Check what you pasted.")
    if pattern and not re.fullmatch(pattern, value):
        print(f"  warning: {key} does not look like the expected format (length {len(value)}).")
        if not confirm(f"  {key} format mismatch."):
            die(f"{key}: not written")


def backup_and_write(path, data, like):
    d = os.path.dirname(os.path.abspath(path))
    if os.path.exists(path):
        bak = f"{path}.bak-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}"
        shutil.copy2(path, bak); os.chmod(bak, 0o600)
        print(f"  previous file kept as {bak}")
    tmp = os.path.join(d, f".{os.path.basename(path)}.tmp{os.getpid()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(data)
    ref = like or (path if os.path.exists(path) else None)
    if ref and os.path.exists(ref):
        st = os.stat(ref)
        try:
            os.chown(tmp, st.st_uid, st.st_gid)
        except PermissionError:
            print("  note: could not copy owner (not root)")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def cmd_env(args):
    src = like = None
    keys = []
    it = iter(args[1:])
    for a in it:
        if a == "--from": src = next(it)
        elif a == "--like": like = next(it)
        else: keys.append(a)
    if not args or not keys:
        die("usage: tc-secret env FILE [--from SRC] [--like REF] KEY [KEY ...]")
    path = args[0]
    base_path = path if os.path.exists(path) else src
    if not os.path.exists(path) and not src and False:
        pass
    vals, order = parse(base_path) if base_path else ({}, [])
    before = dict(vals)
    print(f"tc-secret env: {path}  ({'seeded from ' + src if base_path == src and src else 'existing file' if os.path.exists(path) else 'new file'}; nothing here is read by running services unless FILE is their live env file)")
    for k in keys:
        v = ask(f"  {k} (hidden, then Enter): ")
        check_value(k, v, PATTERNS.get(k))
        if k not in vals:
            order.append(k)
        vals[k] = v
        state = "unchanged" if before.get(k) == v else ("new" if k not in before else "DIFFERENT from the previous value")
        print(f"  {k}: stored, length {len(v)}, {state}")
    data = "\n".join(f"{k}={vals[k]}" for k in order) + "\n"
    backup_and_write(path, data, like or src)
    print(f"tc-secret env: wrote {path} (mode 600). No values were printed.")


def cmd_value(args):
    if not args: die("usage: tc-secret value FILE --kind ping-url|age-recipient [--like REF]")
    path, kind, like = args[0], None, None
    it = iter(args[1:])
    for a in it:
        if a == "--kind": kind = next(it)
        elif a == "--like": like = next(it)
    if kind not in KINDS: die("--kind must be ping-url or age-recipient")
    pattern, hidden = KINDS[kind]
    v = ask(f"  {kind} ({'hidden, ' if hidden else ''}then Enter): ", hidden)
    check_value(kind, v, pattern)
    backup_and_write(path, v + "\n", like)
    if kind == "age-recipient":
        os.chmod(path, 0o644)   # a public key; the script reads it as root
    print(f"tc-secret value: wrote {path}, length {len(v)}. Value not printed.")


def cmd_status(args):
    if not args: die("usage: tc-secret status FILE [--against OTHER]")
    path, other = args[0], None
    if "--against" in args: other = args[args.index("--against") + 1]
    vals, order = parse(path)
    ov = parse(other)[0] if other else {}
    for k in order:
        rel = ""
        if other:
            rel = "  vs " + other + ": " + ("absent" if k not in ov else "same" if h(ov[k]) == h(vals[k]) else "different")
        print(f"  {k:26} set, length {len(vals[k])}{rel}")


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ("env", "value", "status"):
        print(__doc__); sys.exit(2)
    {"env": cmd_env, "value": cmd_value, "status": cmd_status}[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
