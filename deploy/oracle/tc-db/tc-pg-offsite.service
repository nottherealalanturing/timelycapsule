[Unit]
Description=TimelyCapsule encrypted off-site dump copy (Backblaze B2)
After=tc-pg-backup.service network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=RCLONE_IMAGE=rclone/rclone@sha256:7cbeec24a44f206067597c0368be4de90ae19a64d5113c7d1938bd737a81e466
ExecStart=/usr/local/sbin/tc-pg-offsite
# Dump is already created by tc-pg-backup.service; this only uploads.
