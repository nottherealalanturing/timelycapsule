# Production environment template (T-19). Copy this to `.env.production` on
# the server ONLY — never commit the filled-in file (it's already covered by
# `.gitignore`'s `.env.*` rule alongside `!.env.*.example`).
#
# This single file is read two ways by docker-compose.prod.yml:
#   1. As `--env-file .env.production` for compose's own variable
#      interpolation (${GHCR_OWNER}, ${API_DOMAIN}, image tags, etc).
#   2. As each service's `env_file:` — i.e. these become real process env
#      vars inside the api/worker/scheduler/backup containers.
# One file, both jobs — deliberately not split, so there's a single source
# of truth for "what does production need."

# ---- Deploy / image (used by docker-compose.prod.yml + the GitHub Actions
# deploy workflow, not by application code) ----
GHCR_OWNER=your-github-username-or-org
IMAGE_TAG=latest
API_DOMAIN=api.timelycapsule.com

# ---- Core app ----
NODE_ENV=production
PORT=4001
LOG_LEVEL=info
# Web app origin — used to build links in outbound emails.
APP_URL=https://timelycapsule.com

# ---- Postgres (postgres service + DATABASE_URL must agree) ----
POSTGRES_USER=timelycapsule
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=timelycapsule
# Host is the compose service name `postgres`, not localhost — these
# containers talk to each other over the `internal` Docker network.
DATABASE_URL=postgres://timelycapsule:replace-with-a-long-random-value@postgres:5432/timelycapsule

# ---- Auth (T-04) ----
# Generate a real production keypair — do NOT reuse a dev/.env keypair:
#   node apps/api/scripts/generate-jwt-keys.mjs
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# ---- Reveal seal-gate tokens (T-15) ----
# Any long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GATE_TOKEN_SECRET=

# ---- Google OAuth (T-05) ----
GOOGLE_OAUTH_WEB_CLIENT_ID=

# ---- Resend email (T-07) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@timelycapsule.com
# Register the real webhook endpoint (https://api.timelycapsule.com/webhooks/resend)
# in the Resend dashboard once the API is live, then paste its signing secret here.
RESEND_WEBHOOK_SECRET=

# ---- Cloudflare R2 — sealed media storage (T-10) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_MEDIA=tc-media

# ---- Backblaze B2 — nightly DB backup target (T-19 human setup) ----
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=tc-db-backups

# ---- healthchecks.io — scheduler dead-man's switch (T-19 human setup) ----
HEALTHCHECKS_PING_URL=

# ---- Reserved for T-20 (web deploy) — not consumed by any code yet, just
# recorded here so the values collected during human setup aren't lost
# before that ticket wires them in ----
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_MOBILE=
POSTHOG_KEY=
POSTHOG_HOST=
