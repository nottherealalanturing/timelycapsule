# Local dev ports chosen to avoid clashing with other projects on this machine
# (digitalencodeGRC uses 3000/4000). Change freely if you don't have that conflict.
PORT=4001
LOG_LEVEL=info
NODE_ENV=development

# Host port 5433 (not 5432) — see docker-compose.yml comment.
DATABASE_URL=postgres://timelycapsule:timelycapsule@localhost:5433/timelycapsule

# Web app origin (T-07) — used to build links in outbound emails (e.g. the
# password-reset link). Matches apps/web's dev port (:3001).
APP_URL=http://localhost:3001

# JWT RS256 access-token signing keypair (T-04). Generate your own:
#   node apps/api/scripts/generate-jwt-keys.mjs >> apps/api/.env
# Not required in NODE_ENV=test — an ephemeral keypair is generated in memory.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# Reveal seal gate tokens (T-15). Any random string works — e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Not required in NODE_ENV=test — an ephemeral secret is generated in memory.
GATE_TOKEN_SECRET=

# Google OAuth (T-05). Web client ID from Google Cloud Console — see
# plan/PROGRESS.md decisions log for the console setup steps.
GOOGLE_OAUTH_WEB_CLIENT_ID=

# Resend (T-07). API key from resend.com — domain must be verified there
# (SPF/DKIM/DMARC DNS records) before sending real mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Signing secret for POST /webhooks/resend (Resend dashboard → Webhooks →
# create an endpoint once this is deployed to a public URL; not testable
# fully in local dev since Resend can't reach localhost).
RESEND_WEBHOOK_SECRET=

# Cloudflare R2 (T-07 setup, consumed starting T-10 media pipeline).
# Buckets tc-media/tc-backups, private, R2 API token scoped to both.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_MEDIA=tc-media
R2_BUCKET_BACKUPS=tc-backups

# LocationIQ (Product Quality Pass, 2026-08) — reverse geocoding for "Where
# this was written." Free tier: 5,000 lookups/day, 2/sec, no card required.
# Get a key at locationiq.com. Without it, POST /places/reverse-geocode
# returns geocoding_unavailable and the composer falls back to typing a
# place name by hand — coordinates and manual naming still work either way.
LOCATIONIQ_API_KEY=
