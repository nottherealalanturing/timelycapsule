# API base (T-04+ backend, includes /v1 prefix). Dev port is 4001 — see
# apps/api/.env.example comment on why (avoids a clash with another local project).
NEXT_PUBLIC_API_URL=http://localhost:4001/v1

# Google Identity Services web client ID (T-05). Same value as apps/api's
# GOOGLE_OAUTH_WEB_CLIENT_ID — it's public by design (sent to the browser).
NEXT_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=

# PostHog (T-20). Content-blind product analytics — see lib/analytics.ts.
# Project key + region host from the human-setup checklist.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry (T-20). Browser + server error tracking, manually wired via
# instrumentation.ts/instrumentation-client.ts (no build-time upload plugin
# yet — see instrumentation.ts comment).
NEXT_PUBLIC_SENTRY_DSN=

# Canonical production URL (T-20). Used by robots.ts/sitemap.ts. Defaults to
# https://timelycapsule.com if unset.
NEXT_PUBLIC_SITE_URL=
